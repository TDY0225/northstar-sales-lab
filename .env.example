# Required for production canonical, sitemap, robots, and social URLs.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Keep demo mode for the portfolio deployment.
LEAD_PROVIDER=demo

# Only required when LEAD_PROVIDER=hubspot. Never expose this in client code.
HUBSPOT_PRIVATE_APP_TOKEN=

# Reserved for future provider configuration; not read by the current boundary.
HUBSPOT_PORTAL_ID=

# Optional anti-spam verification. Both Turnstile values are required together.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
